# ─── API server ───────────────────────────────────────────────
PORT=8787
# Long random string; the apps reuse it as their auth token. Generate: openssl rand -hex 32
API_TOKEN=change-me-to-a-long-random-string

# ─── Solana RPC (Helius recommended) ──────────────────────────
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# Optional — derived from the WS URL when omitted.
SOLANA_HTTP_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# ─── Meteora rate budget ──────────────────────────────────────
METEORA_TARGET_RPS=15
POLL_MIN_MS=1000
POLL_MAX_MS=30000
POLL_IDLE_MS=300000

# ─── Persistence ──────────────────────────────────────────────
DB_PATH=./data/monitor.db
HISTORY_DAYS=365
SYNC_OVERLAP_SECONDS=3600

# ─── Notifications ────────────────────────────────────────────
# Bark = free iPhone push fallback when no app is active. Leave empty to disable.
BARK_KEY=
BARK_BASE_URL=https://api.day.app
# Seconds without a client heartbeat before it's considered inactive (→ Bark).
PRESENCE_TIMEOUT_SECONDS=30

# ─── CORS (web, optional) ─────────────────────────────────────
# Browser origins allowed (comma-separated). Native apps send no Origin and are unaffected.
WEB_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── LPAgent (authoritative closed PnL: residual valued at market) ─────────────
# Empty key = enrichment disabled; closed PnL falls back to Meteora's raw pnlSol.
# Rate-limited to LPAGENT_RPM requests/min (live close-enrichment + history backfill share it).
LPAGENT_API_KEY=
LPAGENT_BASE_URL=https://api.lpagent.io
LPAGENT_RPM=5

LOG_LEVEL=info

# ─── Swift clients (Meteora LP Monitor macOS + iOS) — baked at build time by `make` ────
# Token is reused from API_TOKEN above. URL optional: Mac & Simulator default to
# localhost; set this only for a physical iPhone (the Mac's LAN/Tailscale address).
CLIENT_API_URL=
