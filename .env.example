# ─── Auth / session ───────────────────────────────────────────
# Secret that signs every session JWT (HS256). REQUIRED — generate a ≥32-char value once and keep it
# STABLE (changing it invalidates every active session): openssl rand -hex 32
AUTH_SECRET=
# The owner's Solana wallet address: auto-whitelisted on boot and flagged as owner when it registers.
# Leave empty to seed no owner (registration is gated by the whitelist).
OWNER_ADDRESS=

# ─── Solana RPC (Helius recommended) ──────────────────────────
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# Optional — derived from the WS URL when omitted.
SOLANA_HTTP_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# RPC rate budget (requests/sec). Defaults are the Helius FREE tier; raise on a higher plan.
SOLANA_RPS=10
SOLANA_GPA_RPS=5
SOLANA_DAS_RPS=2
SOLANA_SEND_RPS=1
# Share of the RPC budget reserved for the LIVE lane (the rest → the history-backfill lane).
SOLANA_LIVE_FRACTION=0.6
# Max wallets backfilling history at once (onboarding admission control).
BACKFILL_CONCURRENCY=3

# ─── Positions source ─────────────────────────────────────────
# 'onchain' (default) = the decoupled on-chain DLMM engine is the single source of positions + PnL
# (no Meteora datapi, all history, event-driven). 'meteora' = legacy datapi path (escape hatch).
POSITIONS_SOURCE=onchain

# ─── Meteora rate budget (only used when POSITIONS_SOURCE=meteora) ─────────────
METEORA_TARGET_RPS=15
POLL_MIN_MS=1000
POLL_MAX_MS=30000
POLL_IDLE_MS=300000

# ─── Persistence (self-hosted Postgres via docker-compose) ────
DATABASE_URL=postgres://meteora:meteora@localhost:5435/meteora
# History depth: rolling window in days, OR an absolute floor date (HISTORY_SINCE wins when set).
HISTORY_DAYS=365
# HISTORY_SINCE=2026-05-01

# ─── Notifications ────────────────────────────────────────────
# Bark = free iPhone push fallback when no app is active. Leave empty to disable.
BARK_KEY=
BARK_BASE_URL=https://api.day.app
PRESENCE_TIMEOUT_SECONDS=30
# Web Push (browser/PWA). Generate once: npx web-push generate-vapid-keys — both keys must stay STABLE.
# Push is disabled when either key is empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@meteora-lp-monitor.local

# Browser origins allowed (comma-separated). Native apps send no Origin and are unaffected. The FIRST
# origin also binds the wallet sign-in (SIWS) challenge — set it to your real web origin in production.
WEB_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Pricing (Jupiter, free, no key) ──────────────────────────
# Live token price source for valuing position token balances in SOL.
JUPITER_PRICE_URL=https://lite-api.jup.ag/price/v3

LOG_LEVEL=info

# ─── Swift clients (macOS + iOS) — API URL baked at build time by `make` ────
# Auth is NOT baked: sign in with your wallet ADDRESS + password in the app's Settings. Account
# creation is web-only (needs a wallet to sign). URL optional: Mac & Simulator default to localhost;
# set this only for a physical iPhone (the Mac's LAN/Tailscale address).
CLIENT_API_URL=
