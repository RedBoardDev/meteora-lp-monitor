{
  "name": "@binsight/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/main.ts",
    "build": "tsup",
    "start": "node --env-file=../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@binsight/shared": "workspace:*",
    "@coral-xyz/anchor": "^0.30.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "@napi-rs/canvas": "^1.0.0",
    "@solana/web3.js": "1.98.4",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "postgres": "^3.4.9",
    "tweetnacl": "1.0.3",
    "undici": "^7.2.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.2",
    "@types/node": "^22.10.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
