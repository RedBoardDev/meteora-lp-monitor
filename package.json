{
  "name": "binsight",
  "version": "0.1.0",
  "description": "Binsight - live PnL, positions and analytics for Meteora DLMM liquidity on Solana (web app + API + native clients).",
  "private": true,
  "license": "MIT",
  "author": "RedBoardDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedBoardDev/meteora-lp-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/RedBoardDev/meteora-lp-monitor/issues"
  },
  "homepage": "https://github.com/RedBoardDev/meteora-lp-monitor#readme",
  "packageManager": "yarn@4.15.0",
  "workspaces": [
    "shared",
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev:api": "yarn workspace @binsight/api dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "turbo": "^2",
    "typescript": "^5.7.3"
  },
  "resolutions": {
    "postcss": ">=8.5.10"
  }
}
