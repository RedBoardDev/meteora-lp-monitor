# deps
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarn/install-state.gz

# build
dist/
.next/
out/
*.tsbuildinfo
.turbo/
coverage/

# data & logs
data/
*.db
*.db-*
logs/
*.log

# env
.env
.env.*
!.env.example

# os / editor
.DS_Store
.idea/
.vscode/

# swift / xcode — generated by XcodeGen / built by SwiftPM (builds go to /tmp via the Makefile)
apps/**/.build/
apps/**/.swiftpm/
apps/Binsight.xcodeproj/
apps/**/*.generated.plist
apps/**/*.xcuserstate
DerivedData/

# agent / scratch (kept out of the public repo)
.claude/
.serena/
**/AGENTS.md
**/CLAUDE.md

# internal docs & planning — kept local, not for the public repo
docs/
TODO.md
**/TEST-PLAN.md

# spike / validation scripts (scratch + local .secrets.env — NEVER committed), EXCEPT the on-chain bench CLIs the
# committed bench depends on (the harness execs them, bundled): leader-control (drives the leader-test wallet) and
# bench-reader (reads positions/fidelity). Everything else in api/scripts/ stays local scratch.
/scripts/
api/scripts/*
!api/scripts/leader-control.ts
!api/scripts/bench-reader.ts
!api/scripts/copybot-config.ts

# copy-bot test wallet keypairs — NEVER committed (real keys, gitignored)
.wallets/

# local research dumps (scratch, never committed)
lpagent_*
